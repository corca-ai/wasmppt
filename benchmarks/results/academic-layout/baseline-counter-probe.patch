+// Temporary native evidence probe; no planner state or decisions depend on these counters.
+#[cfg(not(target_arch = "wasm32"))]
+static PROBE_CANDIDATES: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+#[cfg(not(target_arch = "wasm32"))]
+static PROBE_MEASUREMENTS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+#[cfg(not(target_arch = "wasm32"))]
+pub fn probe_reset() {
+    PROBE_CANDIDATES.store(0, std::sync::atomic::Ordering::Relaxed);
+    PROBE_MEASUREMENTS.store(0, std::sync::atomic::Ordering::Relaxed);
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub fn probe_counts() -> (usize, usize) {
+    (PROBE_CANDIDATES.load(std::sync::atomic::Ordering::Relaxed),
+     PROBE_MEASUREMENTS.load(std::sync::atomic::Ordering::Relaxed))
+}
