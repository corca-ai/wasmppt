{
  "name": "@corca-ai/wasmppt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p test/readme-tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node test/browser-host.integration.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
