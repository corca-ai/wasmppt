{
  "name": "@corca-ai/wasmppt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-worker": {
      "types": "./dist/browser-worker.d.ts",
      "import": "./dist/browser-worker.js"
    },
    "./deck": {
      "types": "./dist/deck.d.ts",
      "import": "./dist/deck.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node test/browser-host.integration.mjs",
    "test:browser:external": "npm run build && node test/browser-external.integration.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "playwright": "^1.62.1"
  }
}
